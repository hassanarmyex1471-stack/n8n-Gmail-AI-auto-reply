        "text": "=You are writing a professional email reply on behalf of the account owner. Write a clear, courteous, and professional reply to the email below. Return only the body of the reply email, with no subject line and no placeholders.\n\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\n\nEmail body:\n{{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a helpful assistant that drafts professional, concise, and polite email replies."
            }
          ]
        }
      }
    },
    {
      "id": "d930e472-230d-4106-9b1a-a9d7d41407c6",
